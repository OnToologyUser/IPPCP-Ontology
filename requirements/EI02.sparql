# EI02: ¿Qué emisiones están asociadas a un distrito determinado durante un periodo determinado? / What emissions are associated with a given district during a given period?

PREFIX eio:    <http://w3id.org/def/emissionsInventoryOntology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX time:   <http://www.w3.org/2006/time#>
PREFIX saref:  <https://saref.etsi.org/core/>
PREFIX s4city: <https://saref.etsi.org/saref4city/>

SELECT ?pollutant ?pollutantLabel ?sector ?sectorLabel ?value ?unit

WHERE {
    VALUES ?district {
        <DISTRICT_IRI>
    }

    VALUES ?year {
        "2024"^^xsd:gYear
    }

    ?district rdf:type s4city:District .

    ?emissionData
        rdf:type s4city:KeyPerformanceIndicatorAssessment ;
        s4city:refersToFeature ?district ;
        s4city:refersToTime ?period ;
        s4city:quantifiesKPI ?pollutant ;
        eio:refersToSector ?sector ;
        saref:hasValue ?value ;
        saref:isMeasuredIn ?unit .

    ?period
        rdf:type time:DateTimeInterval ;
        time:hasDateTimeDescription ?dateTimeDescription .

    ?dateTimeDescription
        rdf:type time:DateTimeDescription ;
        time:year ?year .

    OPTIONAL {
        ?pollutant rdfs:label ?pollutantLabel .
        FILTER(
            LANG(?pollutantLabel) = "en" ||
            LANG(?pollutantLabel) = "es"
        )
    }

    OPTIONAL {
        ?sector rdfs:label ?sectorLabel .
        FILTER(
            LANG(?sectorLabel) = "en" ||
            LANG(?sectorLabel) = "es"
        )
    }
}
ORDER BY ?pollutantLabel ?sectorLabel





