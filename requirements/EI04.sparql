# EI04: ¿Cuál es la cantidad emitida de un contaminante determinado por cada sector durante un periodo determinado? / What is the amount of a given pollutant emitted by each sector during a given period?

PREFIX eio:    <http://w3id.org/def/emissionsInventoryOntology#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX time:   <http://www.w3.org/2006/time#>
PREFIX saref:  <https://saref.etsi.org/core/>
PREFIX s4city: <https://saref.etsi.org/saref4city/>

SELECT ?sector ?sectorLabel ?unit (SUM(xsd:decimal(?value)) AS ?emittedAmount)
WHERE {
    VALUES ?pollutant {
        eio:CO2Scope1Emissions
    }

    VALUES ?year {
        "2024"^^xsd:gYear
    }

    ?emissionData
        rdf:type s4city:KeyPerformanceIndicatorAssessment ;
        s4city:quantifiesKPI ?pollutant ;
        eio:refersToSector ?sector ;
        s4city:refersToTime ?period ;
        saref:hasValue ?value ;
        saref:isMeasuredIn ?unit .

    ?sector rdf:type eio:Sector .

    ?period
        rdf:type time:DateTimeInterval ;
        time:hasDateTimeDescription ?dateTimeDescription .

    ?dateTimeDescription
        rdf:type time:DateTimeDescription ;
        time:year ?year .

    OPTIONAL {
        ?sector rdfs:label ?sectorLabel .
        FILTER(
            LANG(?sectorLabel) = "en" ||
            LANG(?sectorLabel) = "es"
        )
    }
}
GROUP BY ?sector ?sectorLabel ?unit
ORDER BY DESC(?emittedAmount)



